FROM ubuntu:22.04 AS sourcemod-downloads
WORKDIR /download
ARG INSTALL_DIR=/server/tf
RUN mkdir -p "${INSTALL_DIR}"

ARG METAMOD_VERSION=1.12.0-git1228
ARG METAMOD_RELEASE=1.12.0.1228
ARG METAMOD_FILE_NAME=mmsource-${METAMOD_VERSION}-linux.tar.gz
ARG METAMOD_URL=https://github.com/alliedmodders/metamod-source/releases/download/${METAMOD_RELEASE}/${METAMOD_FILE_NAME}
ARG METAMOD_CHECKSUM=29f60bb40154fb4d9d0020ee35347c8359eeaf493dc4fdd7182873cf51f83f47
ADD --checksum=sha256:${METAMOD_CHECKSUM} ${METAMOD_URL} .
RUN tar xf "${METAMOD_FILE_NAME}" -C "${INSTALL_DIR}/"

ARG SOURCEMOD_VERSION=1.12.0-git7263
ARG SOURCEMOD_RELEASE=1.12.0.7263
ARG SOURCEMOD_FILE_NAME=sourcemod-${SOURCEMOD_VERSION}-linux.tar.gz
ARG SOURCEMOD_URL=https://github.com/alliedmodders/sourcemod/releases/download/${SOURCEMOD_RELEASE}/${SOURCEMOD_FILE_NAME}
ARG SOURCEMOD_CHECKSUM=42b2289a0089790661714d661b389135151fd926d309848565e2f7e64f8e7983
ADD --checksum=sha256:${SOURCEMOD_CHECKSUM} ${SOURCEMOD_URL} .
RUN tar xf "${SOURCEMOD_FILE_NAME}" -C "${INSTALL_DIR}/"

FROM tf2-summon-base

ARG INSTALL_DIR=/server/tf
COPY --from=sourcemod-downloads --chown=tf2 "${INSTALL_DIR}/" "${SERVER_DIR}/tf/"
